{
  "extends": ["config:base"],

  "dependencyDashboard": true,

  "packageRules": [
    {
      "matchManagers": ["leiningen"],
      "groupName": "clojure dependencies",
      "groupSlug": "clojure-deps"
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "docker dependencies",
      "groupSlug": "docker-deps"
    }
  ]
}